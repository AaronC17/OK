{
  "name": "onkys-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts server/payments/*.test.ts",
    "test:payments": "node --experimental-strip-types --test server/payments/*.test.ts",
    "payments:dev": "node --env-file=.env.payments.local --experimental-strip-types server/payments/index.ts",
    "payments:demo": "node --env-file=.env.payments.local --experimental-strip-types scripts/payments/demo.ts",
    "test:e2e": "playwright test",
    "seedance": "node --env-file=.env.local --experimental-strip-types seedance/index.ts",
    "seedance:test": "node --env-file=.env.local --experimental-strip-types seedance/test-clip.ts",
    "brand:estimate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/brand-concepts.ts",
    "brand:generate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/brand-concepts.ts --generate",
    "gummies:estimate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/gummies.ts",
    "gummies:preparation:estimate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/preparation.ts"
  },
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "lucide-react": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
