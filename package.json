{
  "name": "onkys-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node --experimental-strip-types scripts/media/bake-mix.ts",
    "dev": "node --env-file-if-exists=.env.store.local node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "tsc -b && vite build && esbuild server/store/api-handler.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "preview": "node --env-file-if-exists=.env.store.local --experimental-strip-types scripts/store-preview.ts",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts server/payments/*.test.ts server/store/*.test.ts",
    "test:store": "node --experimental-strip-types --test server/store/*.test.ts",
    "store:api": "node --env-file-if-exists=.env.store.local --experimental-strip-types server/store/index.ts",
    "migrate:mongo": "node --env-file-if-exists=.env.store.local --experimental-strip-types scripts/migrate-sqlite-to-mongo.ts",
    "mail:preview": "node --experimental-strip-types scripts/mail-preview.ts",
    "mail:test": "node --env-file-if-exists=.env.store.local --experimental-strip-types scripts/mail-test.ts",
    "test:payments": "node --experimental-strip-types --test server/payments/*.test.ts",
    "payments:dev": "node --env-file=.env.payments.local --experimental-strip-types server/payments/index.ts",
    "payments:demo": "node --env-file=.env.payments.local --experimental-strip-types scripts/payments/demo.ts",
    "test:e2e": "playwright test",
    "seedance": "node --env-file=.env.local --experimental-strip-types seedance/index.ts",
    "seedance:test": "node --env-file=.env.local --experimental-strip-types seedance/test-clip.ts",
    "brand:estimate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/brand-concepts.ts",
    "brand:generate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/brand-concepts.ts --generate",
    "gummies:estimate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/gummies.ts",
    "gummies:preparation:estimate": "node --env-file=.env.local --experimental-strip-types scripts/higgsfield/preparation.ts"
  },
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "lucide-react": "^1.56.0",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
