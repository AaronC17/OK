# Copiar a .env.payments.local. No modificar .env.local ni reutilizar sus claves.
# disabled: sin fuente bancaria; mock: únicamente simulación local.
PAYMENTS_MODE=disabled
PAYMENTS_PORT=8787
PAYMENTS_ACCOUNT_ALIAS=bac-personal-demo
# Generar DOS tokens independientes de 32 bytes en base64url (ver documentación).
PAYMENTS_ADMIN_TOKEN=
PAYMENTS_RECONCILE_TOKEN=
