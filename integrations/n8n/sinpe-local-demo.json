    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.demoOnly !== true || !['disabled', 'mock'].includes(result.mode)) {\n  throw new Error('Este flujo solo admite simulaciones locales; no procesar pagos reales.');\n}\nfor (const key of ['processedCount', 'simulatedCount', 'reviewedCount', 'pendingCount', 'manualReviewCount', 'conflictCount']) {\n  if (!Number.isSafeInteger(result[key]) || result[key] < 0) throw new Error('Resumen de conciliación inválido.');\n}\nreturn [{ json: { ...result, aviso: 'SIMULACION. No notificar al cliente como pagado ni entregar productos.' } }];"
      },
