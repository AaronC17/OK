# Opcional para desarrollo. Copiar a .env.store.local solo si necesitas cambiar estos valores.
# Base de datos: si MONGODB_URI está configurado, la tienda usa MongoDB Atlas. Si no, usa SQLite local en STORE_DATA_DIR.
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?appName=Cluster0
# MONGODB_DB_NAME=onkys

STORE_DATA_DIR=.data/store
STORE_API_PORT=8788
STORE_SECURE_COOKIES=false
# Para un despliegue real: HTTPS, cookies Secure y origen exacto autorizado.
# STORE_PUBLIC_ORIGIN=https://tu-dominio-confirmado
