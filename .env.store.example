# Opcional para desarrollo. Copiar a .env.store.local solo si necesitas cambiar estos valores.
# Base de datos: si MONGODB_URI está configurado, la tienda usa MongoDB Atlas. Si no, usa SQLite local en STORE_DATA_DIR.
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?appName=Cluster0
# MONGODB_DB_NAME=onkys

STORE_DATA_DIR=.data/store
STORE_API_PORT=8788
STORE_SECURE_COOKIES=false
# Para un despliegue real: HTTPS, cookies Secure y origen exacto autorizado.
# STORE_PUBLIC_ORIGIN=https://tu-dominio-confirmado

# Avisos por correo al cliente (DirectMail de Alibaba Cloud). Sin estas variables no se envía nada.
# SMTP_HOST depende de la región de la cuenta DirectMail:
#   ap-southeast-1 (Singapur) → smtpdm-ap-southeast-1.aliyun.com
#   otras regiones internacionales → smtpdm.<region>.aliyun.com
# SMTP_HOST=smtpdm-ap-southeast-1.aliyun.com
# SMTP_PORT=465
# SMTP_USER=pedidos@onkys.shop      ← dirección de remitente creada y aprobada en DirectMail
# SMTP_PASS=                        ← contraseña SMTP del remitente (no es tu contraseña de Alibaba)
# MAIL_FROM="Onky's <pedidos@onkys.shop>"
# MAIL_REPLY_TO=                    ← opcional: buzón real donde la tienda atiende respuestas
# MAIL_BCC=                         ← opcional: copia de todos los avisos para el buzón de la tienda
# Guía completa: docs/correos-directmail.md

# Conciliación automática SINPE con n8n (docs/n8n-sinpe-automatico.md). Sin esta variable el endpoint queda deshabilitado.
# Generar: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# BANK_AUTOMATION_TOKEN=
